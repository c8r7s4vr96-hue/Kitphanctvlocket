# Locket KitPhan CTV — Configure these secrets in Vercel Environment Variables (never commit real secrets to GitHub)

# Firebase Admin SDK JSON (from Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_SERVICE_ACCOUNT_JSON=VERCEL_SECRET_JSON_ONLY
FIREBASE_WEB_API_KEY=PUBLIC_FIREBASE_WEB_API_KEY

# Locket API (uplocket.io.vn)
LOCKET_API_BASE_URL=https://uplocket.io.vn
LOCKET_API_KEY=ctv_YOUR_LOCKET_API_KEY
LOCKET_MARKUP_VND=0

# SePay MB Bank Auto Deposit (50,000 - 1,000,000 VND)
MB_BANK_ACCOUNT_NUMBER=89123456789125
MB_BANK_ACCOUNT_NAME=PHAN GIA TU
SEPAY_LIVE_WEBHOOK_SECRET=whsec_YOUR_SEPAY_HMAC_SECRET
CTV_MIN_DEPOSIT_VND=50000
CTV_MAX_DEPOSIT_VND=1000000

# Admin Approval & Activation Email (Resend)
MAIN_ADMIN_GOOGLE_UID=YOUR_GOOGLE_AUTH_UID
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
EMAIL_FROM="Locket KitPhan <onboarding@resend.dev>"
